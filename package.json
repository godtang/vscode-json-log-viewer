{
	"name": "json-log-viewer",
	"displayName": "JSON Log Viewer",
	"description": "View JSON as Table",
	"publisher": "tanggod",
	"version": "1.0.5",
	"engines": {
		"vscode": "^1.53.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "json-log-viewer.OpenView",
				"title": "JSON Log Viewer: Open View"
			}
		],
		"configuration": {
			"title": "JsonViewLog",
			"properties": {
				"json-table-viewer.show-fields": {
					"type": "array",
					"default": [],
					"description": "要显示的字段，空数组表示显示全部字段"
				},
				"json-table-viewer.log-level-field": {
					"type": "string",
					"default": "",
					"description": "日志级别字段名，为空则不过滤"
				},
				"json-table-viewer.log-level-filter": {
					"type": "string",
					"default": "debug",
					"enum": [
						"debug",
						"info",
						"warn",
						"error"
					],
					"description": "最低日志级别，低于此级别的日志将被隐藏"
				},
				"json-table-viewer.max-lines": {
					"type": "number",
					"default": 10000,
					"description": "最多显示的行数，超出后从顶部丢弃"
				},
				"json-table-viewer.batch-size": {
					"type": "number",
					"default": 1000,
					"description": "批量渲染时每批的行数"
				},
				"json-table-viewer.format-embedded-json": {
					"type": "boolean",
					"default": true,
					"description": "是否在字符串值中查找并格式化嵌入的JSON"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "yarn run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "yarn run compile && yarn run lint",
		"test": "node ./out/test/runTest.js"
	},
	"dependencies": {
		"json5": "^2.2.0",
		"vsce": "^2.15.0"
	},
	"devDependencies": {
		"@types/glob": "^7.1.1",
		"@types/mocha": "^7.0.2",
		"@types/node": "^13.11.0",
		"@types/vscode": "^1.53.0",
		"@typescript-eslint/eslint-plugin": "^2.30.0",
		"@typescript-eslint/parser": "^2.30.0",
		"eslint": "^6.8.0",
		"glob": "^7.1.6",
		"mocha": "^7.1.2",
		"typescript": "^5.6.3",
		"vscode-test": "^1.3.0"
	},
	"icon": "icon.png",
	"bugs": {
		"url": "https://github.com/godtang/vscode-json-log-viewer/issues",
		"email": "fake@fake.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/godtang/vscode-json-log-viewer"
	},
	"homepage": "https://github.com/godtang/vscode-json-log-viewer/blob/main/README.md",
	"license": "Apache-2.0"
}